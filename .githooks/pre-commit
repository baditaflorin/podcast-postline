#!/bin/sh
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -eu

gofmt -w cmd internal
CGO_ENABLED=0 go vet ./cmd/... ./internal/...
npm run typecheck
npm run lint
npm run fmt:check

if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run ./cmd/... ./internal/...
else
  echo "golangci-lint not installed; skipping"
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact
else
  echo "gitleaks not installed; install it before release"
fi
